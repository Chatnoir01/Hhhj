{
  "name": "Telegram Community Manager",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "workspaceFolder": "/workspaces/Hhhj/telegram-community-manager",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postStartCommand": "bash scripts/start_codespace.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Telegram Community Manager",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  }
}
